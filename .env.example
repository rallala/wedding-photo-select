# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키 — 절대 커밋/공유 금지, 서버(Route Handler)에서만 사용
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 개발자 콘솔
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 개발자 센터
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 셀렉룸 접속 코드 "카카오톡으로 보내기" 버튼용(로그인과는 무관, 없어도 클립보드 복사로 대체됨)
# 카카오 개발자 콘솔 → 앱 키 → JavaScript 키. 콘솔의 "플랫폼 → Web"에 배포 도메인을 등록해야 동작.
NEXT_PUBLIC_KAKAO_JS_KEY=
